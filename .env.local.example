# Copie este arquivo para .env.local e nunca publique valores reais.

# Perfis do portal: gere um SHA-256 diferente para cada senha.
ADMIN_PASSWORD_HASH=
FRANCHISE_PASSWORD_HASH=
FRANCHISE_POTENTIAL_PASSWORD_HASH=
SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=

# Integração iFood
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_AUTH_MODE=oauth
IFOOD_TOKEN=
IFOOD_TEST_MERCHANT_ID=

NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=info

# Avisos por e-mail (opcional)
DASHBOARD_PUBLIC_URL=
# Senha exibida no texto do aviso (a mesma que o franqueado usa pra entrar no portal).
DASHBOARD_PORTAL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# WhatsApp Cloud API (opcional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=

# Feedback dos franqueados (opcional)
# URL pública do Google Form exibida aos franqueados.
VITE_FEEDBACK_FORM_URL=
# URL CSV da planilha de respostas. Manter como variável Sensitive na Vercel.
FEEDBACK_SHEET_CSV_URL=

# Sincronização Postgres -> dashboard (scripts/sync_postgres_pausados.py)
# Usado só pelo script local/GitHub Actions, não pelo backend em si.
# Dados de conexão do Postgres (schema dados_ifood, tabela produtos_pausados),
# em variáveis separadas em vez de uma connection string única — evita erro
# de parsing ao colar num secret do GitHub.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Só preencha se o provedor exigir SSL (ex.: "require"). Deixe em branco senão.
DB_SSLMODE=
# Senha de admin em TEXTO PURO (a mesma que você digita pra entrar no portal
# como admin) — diferente de ADMIN_PASSWORD_HASH acima, que é só o hash.
DASHBOARD_ADMIN_PASSWORD=

# Botão admin "Atualizar dados" (dispara o workflow_dispatch do GitHub
# Actions a partir do backend). Sem GITHUB_SYNC_TOKEN o botão fica desabilitado
# com aviso, sem quebrar nada. Gere um PAT (fine-grained, só neste repo,
# permissão "Actions: Read and write") e mantenha como variável Sensitive na
# Vercel — nunca no frontend.
GITHUB_SYNC_TOKEN=
GITHUB_SYNC_REPO=matheusleme10/italinhouse_ip
GITHUB_SYNC_WORKFLOW=sync-postgres.yml
GITHUB_SYNC_REF=main
